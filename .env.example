# GIBRAS Environment Configuration
# Copy to .env for local runtime execution

# API Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=gibras_insecure_dev_key_change_in_production_8943729842

# Database Configuration (PostgreSQL with PostGIS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gibras_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gibras_db

# Geospatial Data Directory Paths
DATA_DIR=/Users/thrilokm/GIBRAS/data
CURATED_DATA_DIR=/Users/thrilokm/GIBRAS/data/curated
MODELS_DIR=/Users/thrilokm/GIBRAS/ml/saved_models

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json
